---
import "../styles/global.css";
import "../styles/cinematic.css";
import "../styles/slides.css";
import { SITE } from "../config";
import type { Content } from "../content/types";

interface Props {
  content: Content;
  /** Path of this page, e.g. "/" or "/fr/". The other language is derived from it. */
  path: string;
}

const { content, path } = Astro.props;
const enUrl = new URL("/", SITE.url).href;
const frUrl = new URL("/fr/", SITE.url).href;
const canonical = path === "/fr/" ? frUrl : enUrl;
const ogImage = new URL("/og.png", SITE.url).href;
---

<!doctype html>
<html lang={content.lang} data-design="cinematic">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{content.meta.title}</title>
    <meta name="description" content={content.meta.description} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={content.meta.title} />
    <meta property="og:description" content={content.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Runs before first paint: theme + "js" flag, so there is no flash of the wrong theme.
      (function () {
        const root = document.documentElement;
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {
          // Storage can be blocked (private mode, site data off); fall back to the default below.
        }
        // The design is dark-first: dark unless the visitor chose otherwise with the toggle.
        root.setAttribute("data-theme", saved || "dark");
        root.classList.add("js");
        // Desktop with a mouse and motion allowed gets the slideshow layout. Everyone else keeps the scrolling page.
        // The class is removed again if the animation code fails to load (see ui.ts), so content is never stuck hidden.
        if (
          matchMedia("(min-width: 1024px) and (min-height: 640px) and (hover: hover) and (pointer: fine)").matches &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          root.classList.add("slides");
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>

---
import Base from "../layouts/Base.astro";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import Marquee from "./Marquee.astro";
import Sections from "./Sections.astro";
import type { Content } from "../content/types";

interface Props {
  content: Content;
}
const { content } = Astro.props;
const path = content.lang === "fr" ? "/fr/" : "/";
---

<Base content={content} path={path}>
  <Nav c={content} />
  <main id="main" data-home={content.nav.home} data-sections={content.nav.slides}>
    <Hero c={content} />
    <Marquee />
    <Sections c={content} />
  </main>
  <footer class="site-footer">
    <span>© {new Date().getFullYear()} Younes Ghalloum</span>
  </footer>
</Base>

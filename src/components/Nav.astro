---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import type { Content } from "../content/types";

interface Props {
  c: Content;
}
const { c } = Astro.props;
const lang = c.lang;
---

<a class="skip-link" href="#main">{c.nav.skip}</a>
<nav aria-label="Primary">
  <a class="logo-link" href={lang === "fr" ? "/fr/" : "/"} aria-label="Younes Ghalloum">
    <Image src={logo} alt="" class="logo" height={120} loading="eager" />
  </a>
  <div class="nav-right">
    <ul>
      <li><a href="#contact">{c.nav.contact}</a></li>
    </ul>
    <button type="button" class="view-toggle" data-view-toggle>
      <span class="to-scroll">{c.nav.scrollView}</span>
      <span class="to-slides">{c.nav.slideView}</span>
    </button>
    <div class="lang-switch">
      <a href="/" hreflang="en" lang="en" class="lang-option" aria-current={lang === "en" ? "true" : undefined}>EN</a>
      <span class="lang-switch-divider" aria-hidden="true">/</span>
      <a href="/fr/" hreflang="fr" lang="fr" class="lang-option" aria-current={lang === "fr" ? "true" : undefined}>FR</a>
    </div>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label={lang === "fr" ? "Changer de thème" : "Toggle dark mode"}>
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
      </svg>
    </button>
  </div>
</nav>

---
import { Image } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import type { Content } from "../content/types";

interface Props {
  c: Content;
}
const { c } = Astro.props;
const h = c.hero;
---

<section class="hero" id="top">
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-copy">
    <h1 data-intro style="--d:0">
      <span class="greeting">{h.greeting}</span>{" "}<span class="name">{h.name}</span>
    </h1>
    <p class="typing" data-intro style="--d:1">
      <span class="sr-only">{h.titles[0]}</span>
      <span aria-hidden="true" data-typing={JSON.stringify(h.titles)}>{h.titles[0]}</span>
    </p>
    <p class="stack-line" data-intro style="--d:2">{h.ui}</p>
    <p class="stack-between" data-intro style="--d:3">{h.between}</p>
    <p class="stack-line" data-intro style="--d:4">{h.api}</p>
    <a class="hero-cta" data-intro style="--d:5" href="#projects">{h.cta}</a>
  </div>
  <div class="hero-portrait" data-intro style="--d:3">
    <Image
      src={portrait}
      alt={h.name}
      widths={[480, 800, 1200]}
      sizes="(max-width: 860px) 100vw, 42vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

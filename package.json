{
  "name": "younesghalloum-dev",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/astro.mjs dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "mock:formspree": "node mocks/formspree-server.mjs",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "node scripts/tool.mjs eslint .",
    "lint:css": "node scripts/tool.mjs stylelint \"src/**/*.css\"",
    "lint:html": "node scripts/tool.mjs html-validate \".test-dist/index.html\" \".test-dist/fr/index.html\"",
    "format": "node scripts/tool.mjs prettier --write .",
    "format:check": "node scripts/tool.mjs prettier --check .",
    "typecheck": "node scripts/astro.mjs check",
    "test": "node scripts/tool.mjs vitest run --project unit",
    "test:watch": "node scripts/tool.mjs vitest --project unit",
    "test:coverage": "node scripts/tool.mjs vitest run --project unit --coverage",
    "test:integration": "node scripts/integration.mjs",
    "test:perf": "node scripts/perf.mjs",
    "test:security": "node scripts/security.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "hooks:install": "node scripts/tool.mjs simple-git-hooks",
    "hooks:remove": "node scripts/tool.mjs simple-git-hooks --uninstall",
    "build:test": "node scripts/build-test.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/tool.mjs lint-staged",
    "pre-push": "npm run verify:fast"
  },
  "lint-staged": {
    "*.{ts,mjs,cjs,astro}": "node scripts/tool.mjs eslint --max-warnings=0",
    "*.css": "node scripts/tool.mjs stylelint",
    "*.{ts,mjs,cjs,json,yml}": "node scripts/tool.mjs prettier --check"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.13",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "ogl": "^1.0.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "html-validate": "^11.21.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "secretlint": "^14.0.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^18.1.0",
    "stylelint-config-recommended": "^19.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}

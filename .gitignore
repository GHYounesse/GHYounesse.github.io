
# ---------------------------------------------------------------------------
# Secrets and local configuration: never commit these
# ---------------------------------------------------------------------------
.env
.env.*
# A documented template with no real values is fine to commit.
!.env.example

# Private keys and certificates (the deploy key lives in GitHub secrets, never here).
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
# `npm run build`: what gets deployed.
dist/
# Astro's generated types and cache.
.astro/
.vite/

# ---------------------------------------------------------------------------
# Test, lint and verification output (all regenerated by `npm run verify`)
# ---------------------------------------------------------------------------
# `npm run build:test`: the build the browser, performance and security checks run against.
.test-dist/
# vitest --coverage
coverage/
playwright-report/
test-results/
blob-report/
/playwright/.cache/
# Lighthouse reports.
.lighthouseci/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Package manager: this project uses npm, and package-lock.json IS committed
# (CI runs `npm ci` and a security test requires it). Keep other managers' lockfiles out.
# ---------------------------------------------------------------------------
yarn.lock
pnpm-lock.yaml
bun.lockb
bun.lock
.pnpm-store/

# ---------------------------------------------------------------------------
# Logs and scratch space
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.scratch/
tmp/
.tmp/

# ---------------------------------------------------------------------------
# Editors, OS and local tooling
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/settings.local.json

.DS_Store
.AppleDouble
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Nginx setup for this site. The VPS hosts other projects too, so every site gets its own file in
# /etc/nginx/sites-available/ (linked into sites-enabled/) and its own Certbot certificate.
# The full server guide is VPS-GUIDE.md next to the project folders; this file is only the portfolio's part.
#
# Order: create the two files below, then
#   sudo ln -s /etc/nginx/sites-available/younesghalloum.dev /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d younesghalloum.dev -d www.younesghalloum.dev --redirect
# Certbot adds the HTTPS (443) server blocks and the http -> https redirect, and installs the renewal timer.

# ---- /etc/nginx/snippets/security-headers.conf ---------------------------------------------------------------
# Shared by every location below: Nginx drops inherited add_header lines as soon as a location sets its own.
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header X-Frame-Options "DENY" always;

# ---- /etc/nginx/sites-available/younesghalloum.dev -----------------------------------------------------------
# www -> apex. The redirect is inside a location, not at server level: a server-level "return" runs before
# location matching and would block Certbot's HTTP validation of the www name.
server {
    listen 80;
    listen [::]:80;
    server_name www.younesghalloum.dev;

    location / {
        return 301 https://younesghalloum.dev$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name younesghalloum.dev;

    root /var/www/younesghalloum.dev;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Hashed build assets never change: cache them for a year.
    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include snippets/security-headers.conf;
        try_files $uri =404;
    }

    # HTML must revalidate so a new deploy shows up immediately. No autoindex: no directory listings.
    location / {
        add_header Cache-Control "no-cache" always;
        include snippets/security-headers.conf;
        try_files $uri $uri/ =404;
    }
}

# Another project on the same VPS, for example a Docker app published on 127.0.0.1:8081, gets its own file:
#   server {
#       listen 80;
#       server_name shop.younesghalloum.dev;
#       location / { proxy_pass http://127.0.0.1:8081; ... }
#   }

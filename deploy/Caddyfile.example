# /etc/caddy/Caddyfile (excerpt). Caddy obtains and renews HTTPS certificates automatically.
# One block per site; this VPS hosts other projects too, so each gets its own block.

younesghalloum.dev, www.younesghalloum.dev {
	root * /var/www/younesghalloum.dev
	encode zstd gzip
	file_server

	# www -> apex
	@www host www.younesghalloum.dev
	redir @www https://younesghalloum.dev{uri} permanent

	# Hashed build assets never change: cache them for a year.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# HTML must revalidate so a new deploy shows up immediately.
	@html not path /_astro/*
	header @html Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}

# Another project on the same VPS, for example a reverse-proxied app:
# api.example.com {
# 	reverse_proxy localhost:3000
# }
